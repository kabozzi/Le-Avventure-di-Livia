{
  "expo": {
    "name": "Le Avventure di Livia",
    "slug": "leavventuredilivia",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "leavventuredilivia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#1a0a3e",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0a3e"
    },
    "ios": {
      "supportsTablet": true,
      "requiresFullScreen": true,
      "bundleIdentifier": "com.leavventuredilivia.app"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.leavventuredilivia.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}